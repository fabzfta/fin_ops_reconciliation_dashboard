        source_created_at
    from "finops"."analytics_staging"."stg_stripe_invoices"

),

quickbooks_invoices as (

    select
        quickbooks_invoice_id,
        doc_number,
        quickbooks_customer_id,
        stripe_invoice_id,
        transaction_date,
        due_date,
        total_amount,
        balance_amount,
        currency,
        revenue_account_id
    from "finops"."analytics_staging"."stg_quickbooks_invoices"

),

stripe_identity as (

    select
        client_id,
        external_id as stripe_customer_id
    from "finops"."analytics_core"."identity_map"
    where source_system = 'stripe'
      and entity_type = 'client'

),

resolved_invoices as (

    select
        md5(
            'invoice|stripe|'
            || si.stripe_invoice_id
        ) as invoice_id,

        ident.client_id,

        si.stripe_invoice_id,
        qi.quickbooks_invoice_id,
        si.hubspot_deal_id,

        si.stripe_customer_id,
        qi.quickbooks_customer_id,

        si.invoice_number as stripe_invoice_number,
        qi.doc_number as quickbooks_doc_number,

        si.status as invoice_status,
        si.currency,

        si.subtotal_amount,
        si.total_amount,
        si.amount_due,
        si.amount_paid,
        si.amount_remaining,

        qi.total_amount as quickbooks_total_amount,
        qi.balance_amount as quickbooks_balance_amount,

        si.subscription_id,
        si.billing_reason,
        qi.revenue_account_id,

        si.source_created_at as invoice_created_at,
        qi.transaction_date,
        qi.due_date,

        case
            when qi.quickbooks_invoice_id is null then false
            else true
        end as is_synced_to_quickbooks,

        case
            when qi.quickbooks_invoice_id is null then null
            when si.total_amount = qi.total_amount then true
            else false
        end as amount_reconciled

    from stripe_invoices si

    left join stripe_identity ident
        on ident.stripe_customer_id = si.stripe_customer_id

    left join quickbooks_invoices qi
        on qi.stripe_invoice_id = si.stripe_invoice_id

)

select *
from resolved_invoices
  );
  
